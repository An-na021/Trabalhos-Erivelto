# Vercel: endereço público do servidor das partidas, sem /api no final.
# Deixe vazio para usar o modo local com dev/preview/start.
VITE_API_URL=

# Senha somente do servidor. Use de 12 a 256 caracteres e não compartilhe com participantes.
# Configure no Render ou em um arquivo .env local (ignorado pelo Git).
# ADMIN_PASSWORD=defina-uma-senha-forte-aqui

# Render: configure estas duas variáveis no painel do serviço.
# Use a URL estável de produção da Vercel, sem barra final.
# ALLOWED_ORIGINS=https://seu-quiz.vercel.app
# PUBLIC_SITE_URL=https://seu-quiz.vercel.app
# NODE_VERSION=22
